# Billing/quota project used to query the BigQuery public dataset.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project

# Local ADC (recommended):
#   gcloud auth application-default login
#
# Or point ADC at a service-account key outside this repository:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# Serverless alternatives (set only on the server; never use a VITE_ prefix):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
